# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mercado Pago Checkout Pro
# Create an application in Mercado Pago Developers and use the access token
# from the environment that matches the site (test or production).
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token

# Segunda cuenta de Mercado Pago para split payments (opcional)
# MERCADOPAGO_SECONDARY_ACCESS_TOKEN=your_secondary_mercadopago_access_token

# Public HTTPS URL used by Mercado Pago to return the buyer and send webhooks.
# For local testing, use a public tunnel such as ngrok or Cloudflare Tunnel.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only Supabase key. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gmail SMTP: usar una contraseña de aplicación, nunca la contraseña normal.
GMAIL_USER=habanamix2026@gmail.com
GMAIL_APP_PASSWORD=rtst qrdr ymem trxp
GMAIL_FROM="Habana Mix <habanamix2026@gmail.com>"
