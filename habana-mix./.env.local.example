# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mercado Pago Checkout Pro
# Create an application in Mercado Pago Developers and use the access token
# from the environment that matches the site (test or production).
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token

# Public HTTPS URL used by Mercado Pago to return the buyer and send webhooks.
# For local testing, use a public tunnel such as ngrok or Cloudflare Tunnel.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only Supabase key. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email opcional: el enlace de la entrada se envía después del pago aprobado.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Habana Mix <entradas@tu-dominio.com>"

# Clave privada para el personal que valida entradas en /control-acceso.
ACCESS_CONTROL_KEY=una_clave_larga_y_privada